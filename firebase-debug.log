[debug] [2026-08-24T13:08:47.081Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/assetxtack-eeca0/rulesets {"name":"projects/assetxtack-eeca0/rulesets/7d7fa648-0f70-49eb-aae0-9c88a9d13b73","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isUserId(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    function canReadChat() {\n      return (\n        resource.data.senderId == request.auth.uid ||\n        resource.data.isSystemMessage == true ||\n        resource.data.buyerId == request.auth.uid ||\n        resource.data.sellerId == request.auth.uid ||\n        isOrderParticipant()\n      );\n    }\n\n    function isOrderParticipant() {\n      return isAuthenticated() &&\n        get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.buyerId == request.auth.uid ||\n        get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.sellerId == request.auth.uid;\n    }\n\n    function hasNoForbiddenFields(forbiddenFields) {\n      return !request.resource.data.keys().hasAny(forbiddenFields);\n    }\n\n    // USER PROFILES\n    match /users/{userId} {\n      allow read: if isAuthenticated();\n\n      allow create: if isUserId(userId)\n        && hasNoForbiddenFields([\n          \"walletBalance\",\n          \"escrowBalance\",\n          \"lifetimeSales\",\n          \"kycStatus\",\n          \"sellerVerified\",\n          \"role\",\n          \"bankAccount\",\n          \"verifiedName\",\n          \"verifiedIdType\",\n          \"verifiedIdNumber\",\n          \"verifiedPhoneNumber\",\n          \"verifiedDob\",\n          \"verificationProvider\",\n          \"verificationReference\"\n        ]);\n\n      allow update: if isUserId(userId)\n        && hasNoForbiddenFields([\n          \"walletBalance\",\n          \"escrowBalance\",\n          \"lifetimeSales\",\n          \"kycStatus\",\n          \"sellerVerified\",\n          \"role\",\n          \"bankAccount\",\n          \"verifiedName\",\n          \"verifiedIdType\",\n          \"verifiedIdNumber\",\n          \"verifiedPhoneNumber\",\n          \"verifiedDob\",\n          \"verificationProvider\",\n          \"verificationReference\"\n        ]);\n\n      allow delete: if false;\n    }\n\n    // PUBLIC MARKETPLACE LISTINGS\n    match /listings/{listingId} {\n      allow read: if true;\n      allow create: if false;\n      allow update, delete: if isAuthenticated()\n        && resource.data.sellerId == request.auth.uid;\n    }\n\n    // SECURE ORDERS & CREDENTIAL HANDOVER\n    match /orders/{orderId} {\n      allow read: if isAuthenticated() &&\n        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);\n      allow create: if false;\n      allow update, delete: if false;\n    }\n\n    // CHATS & MESSAGES\n    match /chats/{chatId} {\n      allow read: if isAuthenticated() && canReadChat();\n      allow create: if false;\n      allow update, delete: if false;\n    }\n\n    // NOTIFICATIONS\n    match /notifications/{notificationId} {\n      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow create: if false;\n    }\n\n    // WALLETS\n    match /wallets/{walletId} {\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow write: if false;\n    }\n\n    // WALLET TRANSACTIONS (AUDIT LEDGER)\n    match /walletTransactions/{txId} {\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow create: if false;\n    }\n\n    // WITHDRAWAL REQUESTS\n    match /withdrawalRequests/{requestId} {\n      allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;\n      allow create: if false;\n      allow update, delete: if false;\n    }\n\n    // KYC VERIFICATION\n    match /kyc/{kycId} {\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow create, update: if false;\n    }\n\n    // DISPUTES\n    match /disputes/{disputeId} {\n      allow read: if isAuthenticated() &&\n        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);\n      allow create: if false;\n      allow update: if false;\n    }\n\n    // ESCROW (LOCKED TO SERVER-ONLY OR PARTIES)\n    match /escrow/{escrowId} {\n      allow read: if isAuthenticated() &&\n        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);\n      allow write: if false;\n    }\n\n    // SUPPORT TICKETS\n    match /supportTickets/{ticketId} {\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\n      allow update: if isAuthenticated()\n        && resource.data.userId == request.auth.uid\n        && request.resource.data.diff(resource.data).affectedKeys()\n            .hasOnly([\"updatedAt\"]);\n      allow delete: if false;\n\n      match /messages/{messageId} {\n        allow read: if isAuthenticated() && (\n          resource.data.senderId == request.auth.uid ||\n          resource.data.ticketUserId == request.auth.uid\n        );\n        allow create: if false;\n        allow update, delete: if false;\n      }\n    }\n\n    // REVIEWS\n    match /reviews/{reviewId} {\n      allow read: if true;\n      allow create: if isAuthenticated()\n        && request.resource.data.buyerId == request.auth.uid\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5;\n      allow update: if isAuthenticated() && resource.data.buyerId == request.auth.uid;\n      allow delete: if isAuthenticated() && resource.data.buyerId == request.auth.uid;\n    }\n\n    // PAYSTACK TRANSFERS\n    match /transfers/{transferId} {\n      allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;\n      allow create: if false;\n      allow update, delete: if false;\n    }\n\n    // REVIEW STATS (DENORMALIZED COUNTERS)\n    match /reviewStats/{sellerId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    // ADMIN\n    match /admin/{docId} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-24T13:08:47.019839Z","metadata":{"services":["cloud.firestore"]}}
