[debug] [2026-10-11T13:16:22.673Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/assetxtack-eeca0/rulesets {"name":"projects/assetxtack-eeca0/rulesets/6197f0a3-b024-43b5-a2dc-1ce65a35ed28","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isUserId(expectedId) {\n      return isAuthenticated() && request.auth.uid == expectedId;\n    }\n\n    function isOrderParticipant(orderId) {\n      return isAuthenticated() &&\n        (get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid ||\n         get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId == request.auth.uid);\n    }\n\n    function hasNoForbiddenFields(forbiddenFields) {\n      return !request.resource.data.keys().hasAny(forbiddenFields);\n    }\n\n    match /users/{userId} {\n      allow read: if isAuthenticated();\n\n      function hasNoForbiddenFieldsOnUpdate(forbiddenFields) {\n        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(forbiddenFields);\n      }\n\n      allow create: if isUserId(userId)\n        && request.resource.data.role == 'user'\n        && hasNoForbiddenFields([\n          \"walletBalance\",\n          \"escrowBalance\",\n          \"lifetimeSales\",\n          \"kycStatus\",\n          \"sellerVerified\",\n          \"bankAccount\",\n          \"verifiedName\",\n          \"verifiedIdType\",\n          \"verifiedIdNumber\",\n          \"verifiedPhoneNumber\",\n          \"verifiedDob\",\n          \"verificationProvider\",\n          \"verificationReference\"\n        ]);\n\n      allow update: if isUserId(userId)\n        && (resource.data.role == null || request.resource.data.role == resource.data.role)\n        && hasNoForbiddenFieldsOnUpdate([\n          \"walletBalance\",\n          \"escrowBalance\",\n          \"lifetimeSales\",\n          \"kycStatus\",\n          \"sellerVerified\",\n          \"bankAccount\",\n          \"verifiedName\",\n          \"verifiedIdType\",\n          \"verifiedIdNumber\",\n          \"verifiedPhoneNumber\",\n          \"verifiedDob\",\n          \"verificationProvider\",\n          \"verificationReference\"\n        ]);\n\n      allow delete: if false;\n    }\n\n    match /listings/{listingId} {\n      allow read: if true;\n      allow create: if false;\n      allow update, delete: if isAuthenticated()\n        && resource.data.sellerId == request.auth.uid;\n    }\n\n    match /orders/{orderId} {\n      allow read: if isAuthenticated() &&\n        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);\n      allow create: if false;\n      allow update: if false;\n      allow delete: if false;\n    }\n\n    match /escrowAudit/{auditId} {\n      allow read: if isAuthenticated() &&\n        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);\n      allow write: if false;\n    }\n\n    match /chats/{chatId} {\n      allow read: if isAuthenticated() && (\n        resource.data.senderId == request.auth.uid ||\n        resource.data.buyerId == request.auth.uid ||\n        resource.data.sellerId == request.auth.uid ||\n        isOrderParticipant(resource.data.orderId)\n      );\n      allow create: if false;\n      allow update, delete: if false;\n    }\n\n    match /notifications/{notificationId} {\n      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow create: if false;\n    }\n\n    match /wallets/{walletId} {\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow write: if false;\n    }\n\n    match /walletTransactions/{txId} {\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow create: if false;\n    }\n\n    match /withdrawalRequests/{requestId} {\n      allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;\n      allow create: if false;\n      allow update, delete: if false;\n    }\n\n    match /withdrawalAuditLogs/{logId} {\n      allow read: if false;\n      allow create: if false;\n      allow update, delete: if false;\n    }\n\n    match /kyc/{kycId} {\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow create, update: if false;\n    }\n\n    match /disputes/{disputeId} {\n      allow read: if isAuthenticated() &&\n        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);\n      allow create: if false;\n      allow update: if false;\n    }\n\n    match /escrow/{escrowId} {\n      allow read: if isAuthenticated() &&\n        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);\n      allow write: if false;\n    }\n\n    match /supportTickets/{ticketId} {\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\n      allow update: if isAuthenticated()\n        && resource.data.userId == request.auth.uid\n        && request.resource.data.diff(resource.data).affectedKeys()\n            .hasOnly([\"updatedAt\"]);\n      allow delete: if false;\n\n      match /messages/{messageId} {\n        allow read: if isAuthenticated() && (\n          resource.data.senderId == request.auth.uid ||\n          resource.data.ticketUserId == request.auth.uid\n        );\n        allow create: if false;\n        allow update, delete: if false;\n      }\n    }\n\n    match /reviews/{reviewId} {\n      allow read: if true;\n      allow create: if isAuthenticated()\n        && request.resource.data.buyerId == request.auth.uid\n        && request.resource.data.rating >= 1\n        && request.resource.data.rating <= 5;\n      allow update: if isAuthenticated() && resource.data.buyerId == request.auth.uid;\n      allow delete: if isAuthenticated() && resource.data.buyerId == request.auth.uid;\n    }\n\n    match /transfers/{transferId} {\n      allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;\n      allow create: if false;\n      allow update, delete: if false;\n    }\n\n    match /reviewStats/{sellerId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    match /admin/{docId} {\n      allow read, write: if false;\n    }\n  }\n}","name":"firestore.rules"}]},"createTime":"2026-10-11T13:16:22.714175Z","metadata":{"services":["cloud.firestore"]}}
